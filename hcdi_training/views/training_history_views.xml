<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- List View for Training History -->
    <record id="view_hcdi_training_history_tree" model="ir.ui.view">
        <field name="name">hcdi.training.history.list</field>
        <field name="model">hcdi.training.history</field>
        <field name="arch" type="xml">
            <list string="Riwayat Training Karyawan">
                <field name="employee_id"/>
                <field name="department_id"/>
                <field name="channel_id"/>
                <field name="trainer_id"/>
                <field name="completion_date"/>
                <field name="score_pretest"/>
                <field name="score_quiz"/>
                <field name="score_posttest"/>
                <field name="final_score"/>
                <field name="passing_grade"/>
                <field name="state" widget="badge"
                       decoration-success="state == 'passed'"
                       decoration-danger="state == 'failed'"
                       decoration-info="state == 'draft'"/>
                <field name="certificate_number"/>
            </list>
        </field>
    </record>

    <!-- Form View for Training History -->
    <record id="view_hcdi_training_history_form" model="ir.ui.view">
        <field name="name">hcdi.training.history.form</field>
        <field name="model">hcdi.training.history</field>
        <field name="arch" type="xml">
            <form string="Detail Riwayat Training">
                <header>
                    <button name="action_generate_certificate"
                            type="object"
                            string="Cetak &amp; Kirim Sertifikat"
                            class="btn-primary"
                            invisible="state != 'passed'"/>
                    
                    <field name="state" widget="statusbar" statusbar_visible="draft,passed,failed"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="employee_id" placeholder="Pilih Karyawan..."/>
                        </h1>
                        <h3>
                            <field name="channel_id" placeholder="Pilih Course Training..."/>
                        </h3>
                    </div>
                    <group>
                        <group string="Informasi Pelaksanaan">
                            <field name="department_id"/>
                            <field name="job_id"/>
                            <field name="trainer_id"/>
                            <field name="start_date"/>
                            <field name="completion_date"/>
                        </group>
                        <group string="Hasil Evaluasi &amp; Nilai Ujian">
                            <field name="score_pretest" readonly="1" force_save="1"/>
                            <field name="score_quiz" readonly="1" force_save="1"/>
                            <field name="score_posttest" readonly="1" force_save="1"/>
                            <field name="final_score" class="oe_subtotal_footer_separator"/>
                            <field name="passing_grade"/>
                        </group>
                    </group>
                    <group string="Informasi Sertifikat" invisible="state != 'passed'">
                        <field name="certificate_number"/>
                        <field name="certificate_file" filename="certificate_filename"/>
                        <field name="certificate_filename" invisible="1"/>
                    </group>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <!-- Action Window for Training History -->
    <record id="action_hcdi_training_history" model="ir.actions.act_window">
        <field name="name">Riwayat Training Karyawan</field>
        <field name="res_model">hcdi.training.history</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Belum ada data riwayat training.
            </p>
        </field>
    </record>

    <!-- Menuitem for Training History -->
    <menuitem id="menu_hcdi_training_history_list"
              name="Riwayat &amp; Penilaian Training"
              parent="menu_hcdi_training_operations"
              action="action_hcdi_training_history"
              sequence="20"/>
</odoo>
