<?xml version='1.0' encoding='utf-8'?>
<odoo>
    <data>

        <record id="training_session_view_list" model="ir.ui.view">
            <field name="name">training.session.view.list</field>
            <field name="model">training.session</field>
            <field name="arch" type="xml">
                <list>
                    <field name="start_date"/>
                    <field name="name"/>
                    <field name="duration"/>
                    <field name="seats"/>
                    <field name="instruktur_id"/>
                </list>
            </field>
        </record>

        <record id="training_session_view_form" model="ir.ui.view">
            <field name="name">training.session.view.form</field>
            <field name="model">training.session</field>
            <field name="arch" type="xml">
                <form string="">
                    <header>
                        <button string="Proses" name="action_confirm" type="object" class="oe_highlight" invisible="state != 'draft'"/>
                        <button string="Selesai" name="action_done" type="object" invisible="state != 'confirm'"/>
                        <button string="Reset" name="action_draft" type="object" invisible="state not in ('confirm', 'done')"/>
                        <field name="state" widget="statusbar" statusbar_visible="draft,confirm,done"/>
                    </header>
                    <sheet>
                        <widget name="web_ribbon" text="Selesai" bg_color="text-bg-info" invisible="state != 'done'"/>
                        <group string="Informasi Sesi">
                            <group>
                                <field name="name" readonly="state != 'draft'"/>
                                <field name="course_id" readonly="state != 'draft'"/>
                                <field name="start_date" readonly="state != 'draft'"/>
                            </group>
                            <group>
                                <field name="duration" readonly="state != 'draft'"/>
                                <field name="seats" readonly="state != 'draft'"/>
                                <field name="jml_peserta"/>
                            </group>
                        </group>
                        <group name="instruktur" string="Data Instruktur">
                            <group>
                                <field name="instruktur_id" readonly="state != 'draft'"/>
                                <field name="jenis_kelamin"/>
                            </group>
                            <group>
                                <field name="no_hp"/>
                                <field name="email"/>
                            </group>
                        </group>
                        <notebook>
                            <page string="Peserta">
                                <field name="peserta_ids" readonly="state != 'draft'">
                                    <list>
                                        <field name="name"/>
                                        <field name="jenis_kelamin"/>
                                        <field name="mobile"/>
                                    </list>
                                </field>
                            </page>
                        </notebook>
                    </sheet>
                    <group>
                        <chatter reload_on_follower="True"/>
                    </group>
                </form>
            </field>
        </record>


        <record id="training_session_action" model="ir.actions.act_window">
            <field name="name">Sesi Training</field>
            <field name="type">ir.actions.act_window</field>
            <field name="res_model">training.session</field>
            <field name="view_mode">list,form</field>
            <field name="help" type="html">
                <p class="oe_view_nocontent_create">
                    <!-- Add Text Here -->
                </p><p>
                
                </p>
            </field>
        </record>


        <!-- This Menu Item must have a parent and an action -->
        <menuitem id="sesi_training_menu_act" name="Sesi Training" parent="training_menu" action="training_session_action" sequence="10"/>
        
    
    </data>
    
</odoo>