<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Form View -->
    <record id="view_hospital_appointment_form" model="ir.ui.view">
        <field name="name">hospital.appointment.form</field>
        <field name="model">hospital.appointment</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_in_consultation" string="In Consultation" type="object" class="oe_highlight" data-hotkey="i" invisible="state != 'draft'" help="Klik tombol ini untuk mengubah status menjadi 'In Consultation'."/>
                    <button name="action_done" string="Mark as Done" type="object" data-hotkey="d" invisible="state != 'in_consultation'" help="Klik tombol ini untuk mengubah status menjadi 'Done'."/>
                    <button name="%(om_hospital.action_cancel_appointment_wizard)d" string="Cancel" type="action" class="oe_highlight" data-hotkey="c" invisible="state not in ('draft', 'in_consultation')" context="{'default_reason': 'cancel'}" help="Klik tombol ini untuk mengubah status menjadi 'Cancel'."/>
                    <button name="action_draft" string="Reset to Draft" type="object" class="oe_highlight" data-hotkey="a" invisible="state != 'cancel'" help="Klik tombol ini untuk mengubah status kembali menjadi 'Draft'."/>
                    <field name="state" widget="statusbar" nolabel="1" readonly="1"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="priority" widget="priority" class="mr-3" options="{'clickable':1}"/>
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="patient_id" widget="selection"/>
                            <field name="ref" readonly="1" force_save="1"/>
                            <field name="gender"/>
                            <field name="doctor_id" widget="many2one_avatar_user"/>
                            <field name="booking_date" default_focus="1"/>
                        </group>
                        <group>
                            <field name="hide_sales_price"/>
                            <field name="appointment_time"/>
                            <button name="action_test" string="Object Button" type="object" confirm="Are you sure to execute pyhton code?" class="oe_highlight" help="Klik tombol ini untuk menjalankan fungsi percobaan (test) pada sistem."/>
                            <button name="%(om_hospital.action_hospital_patient)d" string="Action Button" confirm="Are you sure to open the patient action?" type="action" help="Klik tombol ini untuk melihat dan membuka daftar seluruh data pasien."/>
                        </group>
                    </group>
                    <notebook>
                        <page name="progress" string="Progress">
                            <field name="progress" widget="gauge" options="{'style':{'width':'100px','height':'100px'}}"/>
                        </page>
                        <page name="prescription" string="Prescription">
                            <field name="prescription" placeholder="Enter Prescription here" options="{'collaborative': true, 'resizable': true, 'codeview': true}"/>
                        </page>
                        <page name="pharmacy" string="Pharmacy">
                            <field name="appointment_pharmacy_lines_ids">
                                <list multi_edit="1">
                                    <field name="product_id"/>
                                    <field name="price_unit" column_invisible="parent.hide_sales_price"/>
                                    <field name="qty"/>
                                    <field name="total"/>
                                </list>
                                <form>
                                    <group>
                                        <field name="product_id"/>
                                        <field name="price_unit" invisible="parent.hide_sales_price"/>
                                        <field name="qty"/>
                                        <field name="total"/>
                                    </group>
                                </form>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_hospital_appointment_calendar" model="ir.ui.view">
        <field name="name">hospital.appointment.calendar</field>
        <field name="model">hospital.appointment</field>
        <field name="arch" type="xml">
            <calendar string="Appointment"
                      date_start="booking_date"
                      date_delay="duration"
                      color="state"
                      quick_create="false"
                      hide_time="True"
                      event_open_popup="True"
                      form_view_id="%(om_hospital.view_hospital_appointment_form)d"
                      event_limit="5">
                <field name="patient_id" filters="1" avatar_field="image"/>
                <field name="state" filters="1" invisible="1"/>
            </calendar>
        </field>
    </record>

    <!-- List View -->
    <record id="view_hospital_appointment_list" model="ir.ui.view">
        <field name="name">hospital.appointment.list</field>
        <field name="model">hospital.appointment</field>
        <field name="arch" type="xml">
            <list decoration-info="state == 'draft'" decoration-warning="state == 'in_consultation'" decoration-success="state == 'done'" decoration-danger="state == 'cancel'" sample="1" multi_edit="1">
                <header>
                    <button name="action_in_consultation" string="In Consultation" type="object" class="oe_highlight" data-hotkey="i"/>
                    <button name="action_done" string="Done" type="object" class="oe_highlight" data-hotkey="d"/>
                    <button name="action_cancel" string="Cancel" type="object" class="oe_highlight" data-hotkey="c" />
                    <button name="action_draft" string="Reset to Draft" type="object" class="oe_highlight" data-hotkey="a"/>
                </header>
                <field name="priority" widget="priority"/>
                <field name="patient_id"/>
                <field name="ref" optional="show"/>
                <field name="doctor_id" widget="many2one_avatar_user"/>
                <field name="gender" optional="hide"/>
                <field name="appointment_time"/>
                <field name="booking_date" optional="hide"/>
                <field name="activity_ids" widget="list_activity" optional="show"/>
                <field name="state" widget="badge" decoration-info="state == 'draft'" decoration-warning="state == 'in_consultation'" decoration-success="state == 'done'" decoration-danger="state == 'cancel'" optional="show"/>
                <button name="action_done" type="object" class="fa fa-check btn btn-success" data-hotkey="a" invisible="state != 'in_consultation'"/>
                <button name="%(om_hospital.action_cancel_appointment_wizard)d" type="action" class="fa fa-times btn-danger" context="{'default_reason': 'cancel', 'hide_appointment': True}" data-hotkey="z" invisible="state not in ['draft','in_consultation']"/>
                <groupby name="patient_id">
                    <button name="edit" type="edit" icon="fa-edit" title="Edit"/>
                </groupby>
                <field name="progress" widget="progressbar"/>
            </list>
        </field>
    </record>

    <!-- Activity View -->
    <record id="view_hospital_appointment_activity" model="ir.ui.view">
        <field name="name">hospital.appointment.activity</field>
        <field name="model">hospital.appointment</field>
        <field name="arch" type="xml">
            <activity string="Appoinment Activity">
                <field name="patient_id"/>
                <field name="ref"/>
                <templates>
                    <div t-name="activity-box">
                        <img t-att-src="activity_image('hospital.patient','image',record.patient_id.raw_value)" t-att-alt="record.patient_id.value" class="float-right"/>
                        <div>
                            <field name="ref" display="full"/>
                        </div>
                    </div>
                </templates>
            </activity>
        </field>
    </record>

    <!-- Search View -->
    <record id="view_hospital_appointment_search" model="ir.ui.view">
        <field name="name">hospital.appointment.search</field>
        <field name="model">hospital.appointment</field>
        <field name="arch" type="xml">
            <search>
            </search>
        </field>
    </record>

    <!-- Action for Appointment -->
    <record id="action_hospital_appointment" model="ir.actions.act_window">
        <field name="name">Appointment</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">hospital.appointment</field>
        <field name="view_mode">list,kanban,form,activity,calendar</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create your first appointment!
            </p>
        </field>
    </record>

    <menuitem id="menu_appointment_list" name="Appointments" parent="menu_appointment_master" action="action_hospital_appointment" sequence="10"/>
</odoo>