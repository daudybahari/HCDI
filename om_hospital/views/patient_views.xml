<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

        <record id="action_generate_patient_code" model="ir.actions.server">
            <field name="name">Generate Patient Code</field>
            <field name="model_id" ref="om_hospital.model_hospital_patient"/>
            <field name="binding_model_id" ref="om_hospital.model_hospital_patient"/>
            <field name="state">code</field>
            <field name="code">
for record in records:
    if not record.patient_code or not record.patient_code.startswith('PC'):
        record.write({'patient_code': env['ir.sequence'].next_by_code('hospital.patient.code')})
            </field>
        </record>


        <record id="view_hospital_patient_form" model="ir.ui.view">
            <field name="name">hospital.patient.form</field>
            <field name="model">hospital.patient</field>
            <field name="arch" type="xml">
                <form export_xlsx="1">
                    <sheet>
                        <div class="oe_button_box" name="button_box">
                            <button class="oe_stat_button" type="object" name="action_view_appointments" icon="fa-star">
                                <field string="Appointment" name="appointment_count" widget="statinfo"/>
                            </button>
                        </div>
                        <div class="alert alert-info text-center o_form_header" role="alert"
                            invisible="is_birthday == False">
                            <a class="close" data-dismiss="alert" href="#">×</a>
                            <div>
                                <strong>Today is Birthday !</strong>
                            </div>
                            <div>Wish <field name="name" readonly="1"/>
                            </div>
                        </div>
                        <field name="image" widget="image" class="oe_avatar"/>
                        <field name="photo" invisible="1"/>
                        <div class="oe_title">
                            <h1>
                                <field name="name" placeholder="Patient Name"/>
                            </h1>
                        </div>
                        <group>
                            <group>
                                <field name="patient_code"/>
                                <field name="date_of_birth"/>
                                <field name="age" avg="Average Age"/>
                                <field name="blood_type"/>
                            </group>
                            <group>
                                <field name="phone" widget="phone"/>
                                <field name="gender" widget="radio"/>
                                <field name="ref"/>
                                <field name="tag_ids" widget="many2many_checkboxes" options="{'color_field': 'color'}"/>
                                <field name="active" invisible="1"/>
                                <field name="is_birthday" invisible="1"/>
                                <!-- <field name="appointment_count" sum="Total Appointment"/> -->
                            </group>
                        </group>
                        <group string="Other Information" name="other_info">
                            <group>
                                <field name="parent" invisible="age &gt; 18"/>
                                <field name="marital_status" invisible="age &gt; 18"/>
                                <field name="partner_name" invisible="marital_status != 'married'"/>
                            </group>
                            <group>
                                <field name="phone" widget="phone"/>
                                <field name="email" widget="email"/>
                                <field name="website" widget="url"/>
                            </group>
                            <field name="address" placeholder="Patient Address..."/>
                            <field name="appointment_id"/>
                        </group>
                    </sheet>
                    <chatter/>
                </form>
            </field>
        </record>

        <record id="view_hospital_patient_list" model="ir.ui.view">
            <field name="name">hospital.patient.list</field>
            <field name="model">hospital.patient</field>
            <field name="arch" type="xml">
                <list>
                    <field name="patient_code"/>
                    <field name="name" string="Patient Name"/>
                    <field name="phone"/>
                    <field name="blood_type"/>
                    <field name="ref" string="Reference" optional="show"/>
                    <field name="age" string="Age" optional="hide"/>
                    <field name="gender" string="Gender" optional="show"/>
                    <field name="appointment_count" optional="hide"/>
                    <field name="tag_ids" widget="many2many_tags" optional="show" options="{'color_field': 'color'}"/>
                    <field name="activity_ids" widget="list_activity" optional="show"/>
                    <field name="active" string="Active" optional="hide"/>
                </list>
            </field>
        </record>

        <!-- search View -->
        <record id="view_hospital_patient_search" model="ir.ui.view">
            <field name="name">hospital.patient.search</field>
            <field name="model">hospital.patient</field>
            <field name="arch" type="xml">
                <search>
                    <field name="name" filter_domain="['|', ('name', 'ilike', self), ('ref', 'ilike', self)]"/>
                    <field name="ref"/>
                    <field name="age"/>
                    <field name="gender"/>
                    <field name="active"/>

                    <filter name="male" string="Male" domain="[('gender', '=', 'male')]"/>
                    <filter name="female" string="Female" domain="[('gender', '=', 'female')]"/>
                    <filter name="age_kids" string="Age (0-10)" domain="[('age', '&gt;=', 0), ('age', '&lt;=', 10)]"/>
                    <filter name="active_patient" string="Active" domain="[('active', '=', True)]"/>
                    <filter name="inactive_patient" string="Inactive" domain="[('active', '=', False)]"/>
                    <filter name="archived_patient" string="Archived" domain="[('active', '=', False)]"/>

                    <group expand="0" string="Group By">
                        <filter string="Gender" name="gb_gender" context="{'group_by':'gender'}"/>
                        <filter string="Age" name="gb_age" context="{'group_by':'age'}"/>
                    </group>
                    <searchpanel>
                        <field name="gender" enable_counters="1" icon="fa-users" select="multi"/>
                    </searchpanel>
                </search>
            </field>
        </record>

        <!-- Action for Patient -->
        <record id="action_hospital_patient" model="ir.actions.act_window">
            <field name="name">Patients</field>
            <field name="type">ir.actions.act_window</field>
            <field name="res_model">hospital.patient</field>
            <field name="view_mode">list,kanban,form</field>
            <field name="context">{'search_default_male': 1, 'search_default_gb_gender': 1}</field>
            <field name="help" type="html">
                <p class="o_view_nocontent_smiling_face">
                    Create your first patient!
                </p>
            </field>
        </record>

    </data>
    <menuitem id="menu_patient" name="Patients" parent="menu_patient_master" action="action_hospital_patient" sequence="10"/>
</odoo>