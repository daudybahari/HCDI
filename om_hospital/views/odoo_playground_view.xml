<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_odoo_playground_form" model="ir.ui.view">
        <field name="name">odoo.playground.form</field>
        <field name="model">odoo.playground</field>
        <field name="arch" type="xml">
            <form string="Playground">
                <group>
                    <field name="model_id"/>
                    <field name="code" widget="ace" options="{'mode': 'python'}"/>
                </group>
                <group>
                    <field name="result"/>
                </group>
                <footer>
                    <button name="action_execute" type="object" string="Execute" class="btn-primary" icon="fa-cogs"/>
                    <button string="Close" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_odoo_playground" model="ir.actions.act_window">
        <field name="name">Odoo Playground</field>
        <field name="res_model">odoo.playground</field>
        <field name="view_mode">form</field>
        <field name="target">inline</field>
    </record>

    <menuitem id="menu_technical" name="Technical" sequence="180" parent="menu_hospital_root">
        <menuitem id="menu_odoo_playground" name="Playground" action="action_odoo_playground" sequence="10"/>
    </menuitem>
</odoo>
