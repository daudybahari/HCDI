<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>


        <!-- List View -->
        <record id="view_patient_tag_list" model="ir.ui.view">
            <field name="name">patient.tag.list</field>
            <field name="model">patient.tag</field>
            <field name="arch" type="xml">
                <list string="Patient Tags">
                    <field name="name"/>
                    <field name="color" widget="color_picker"/>
                    <field name="active" widget="boolean_toggle"/>
                </list>
            </field>
        </record>

        <!-- Form View -->
        <record id="view_patient_tag_form" model="ir.ui.view">
            <field name="name">patient.tag.form</field>
            <field name="model">patient.tag</field>
            <field name="arch" type="xml">
                <form string="Patient Tag">
                    <sheet>
                        <group>
                            <field name="name"/>
                            <field name="sequence"/>
                        </group>
                        <group>
                            <field name="color" widget="color_picker"/>
                            <field name="color_2" widget="color"/>
                            <field name="active" widget="boolean_toggle"/>
                        </group>
                    </sheet>
                </form>
            </field>
        </record>

        <!-- Search View -->
        <record id="view_patient_tag_search" model="ir.ui.view">
            <field name="name">patient.tag.search</field>
            <field name="model">patient.tag</field>
            <field name="arch" type="xml">
                <search string="Search Patient Tags">
                    <field name="name"/>
                    <field name="color" />
                    <filter name="active" string="Active" domain="[('active', '=', True)]"/>
                    <filter name="inactive" string="Archived" domain="[('active', '=', False)]"/>
                </search>
            </field>
        </record>

        <!-- Action -->
        <record id="action_patient_tag" model="ir.actions.act_window">
            <field name="name">Patient Tags</field>
            <field name="type">ir.actions.act_window</field>
            <field name="res_model">patient.tag</field>
            <field name="view_mode">list,form</field>
            <field name="help" type="html">
                <p class="o_view_nocontent_smiling_face">
                    Create your first patient tag!
                </p>
            </field>
        </record>

    </data>
    <menuitem id="menu_patient_tag" name="Patient Tags" parent="menu_configuration" action="action_patient_tag" sequence="10"/>
</odoo>